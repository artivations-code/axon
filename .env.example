# WordPress MCP connection
# Copy this file to `.env` and fill in your values. `.env` is gitignored — never commit it.

# Base URL of your self-hosted WordPress site (no trailing slash, include https://)
WORDPRESS_SITE_URL=https://your-site.example.com

# The WordPress user the Application Password belongs to (login name, not email)
WORDPRESS_USERNAME=your-wp-username

# The Application Password from Users -> Profile -> Application Passwords.
# WordPress shows it with spaces (e.g. "abcd EFGH ijkl MNOP qrst UVWX").
# Keep the double quotes — the spaces break `source .env` without them.
WORDPRESS_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"
